# Ghosted Environment Variables
# Copy this file to .env and fill in your values

# Note: OAuth credentials are stored in the app's settings
# and in macOS Keychain for security. This file is just for
# reference and optional configuration.

# Development mode (automatically set by Vite)
# NODE_ENV=development

# Optional: Custom OAuth redirect URI (default: http://localhost:3000/oauth/callback)
# OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback

# Optional: Enable verbose logging
# DEBUG=true
